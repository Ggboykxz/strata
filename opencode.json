{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": ["docs/CONSTITUTION.md"],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    "orchestrator": {
      "description": "STRATA orchestrator: selects one task, guards the invariants, writes docs and state only, delegates every other path through a handoff.",
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "**", "effect": "deny" },
        { "action": "edit", "resource": "docs/**", "effect": "allow" },
        { "action": "edit", "resource": "AGENTS.md", "effect": "allow" },
        { "action": "edit", "resource": "opencode.json", "effect": "allow" },
        { "action": "shell", "resource": "git *", "effect": "allow" },
        { "action": "shell", "resource": "pnpm *", "effect": "allow" },
        { "action": "shell", "resource": "node *", "effect": "allow" },
        { "action": "shell", "resource": "python3 *", "effect": "allow" },
        { "action": "shell", "resource": "bash -n *", "effect": "allow" },
        { "action": "shell", "resource": "git push --force*", "effect": "ask" },
        { "action": "shell", "resource": "git push -f*", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.85"]
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_TOKEN}"
        }
      },
      "hf": {
        "type": "remote",
        "url": "https://huggingface.co/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:HF_TOKEN}"
        }
      }
    }
  }
}
