def remove(*args, **kwargs):
    raise NotImplementedError("rembg is intentionally absent from the AI-001 smoke path (--no-remove-bg); no background-removal model is downloaded or used")
"""TripoSR smoke shim: torchmcubes (git-only, CUDA build) -> scikit-image marching_cubes.

The 3D model weights and the marching-cubes algorithm are unchanged (classic marching cubes); only the
CUDA extension build is avoided. See docs/qa/AI_THROUGHPUT.md for the recorded deviation.
"""
import numpy as np
import torch
from skimage.measure import marching_cubes as _sk_mc


def marching_cubes(volume, isolevel):
    vol = volume.detach().cpu().numpy()
    verts, faces, _normals, _values = _sk_mc(vol, isolevel)
    return torch.from_numpy(verts.astype(np.float32)), torch.from_numpy(faces.astype(np.int64))
